# Frontend configuration. Copy to .env.local (git-ignored).
#
# WARNING: Create React App inlines every REACT_APP_* variable into the
# production bundle as a literal string. Anything placed here is readable by
# every visitor. Never put an API key or secret in this file.
#
# This is why the OpenAI key is no longer a frontend variable: image generation
# now goes through the backend's POST /generate endpoint.

# Backend base URL. Defaults to the deployed App Engine service if unset.
REACT_APP_API_BASE_URL=http://localhost:8080
