# Backend configuration. Copy to .env (git-ignored) and fill in real values.
# Every variable below is required: the server refuses to start without them.

# Elasticsearch. Use https in any shared environment -- basic auth over plain
# http puts this password on the wire in cleartext.
ES_URL=https://your-es-host:9200
ES_USERNAME=replace-me
ES_PASSWORD=replace-me

# Google Cloud Storage bucket for uploaded and generated media.
GCS_BUCKET=your-bucket-name

# HS256 signing key for session tokens. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# Server-side OpenAI key. This must never be exposed to the browser.
OPENAI_API_KEY=sk-replace-me

# Comma-separated list of allowed frontend origins. "*" is rejected.
ALLOWED_ORIGINS=http://localhost:3000

# Optional. App Engine sets this automatically; defaults to 8080 locally.
# PORT=8080

# Optional. One of debug, info, warn, error. Defaults to info. An unrecognised
# value is rejected at startup rather than silently ignored, because a typo would
# otherwise show up only as log lines that never appear.
#
# debug adds per-request detail: rejected tokens, unparseable bodies, stored
# objects. Useful locally, too noisy and too revealing for production.
# LOG_LEVEL=info
