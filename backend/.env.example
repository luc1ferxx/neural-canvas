# Backend configuration. Copy to .env (git-ignored) and fill in real values.
# Every variable below is required: the server refuses to start without them.

# Elasticsearch. Use https in any shared environment -- basic auth over plain
# http puts this password on the wire in cleartext.
ES_URL=https://your-es-host:9200
ES_USERNAME=replace-me
ES_PASSWORD=replace-me

# Google Cloud Storage bucket for uploaded and generated media.
GCS_BUCKET=your-bucket-name

# HS256 signing key for session tokens. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# Server-side OpenAI key. This must never be exposed to the browser.
# Required only when IMAGE_PROVIDER is openai.
OPENAI_API_KEY=sk-replace-me

# How /generate produces an image. One of:
#   openai  (default) call DALL-E. Requires OPENAI_API_KEY, and costs money per
#           request.
#   stub    render a local placeholder PNG and make no network call. Everything
#           after the image exists is identical -- the same content sniffing, the
#           same storage write, the same index write -- so this exercises the whole
#           pipeline except the part that is billed.
#
# It is a named switch rather than being inferred from a missing key, because
# guessing wrong in that direction means a deployment quietly serving placeholders
# instead of failing at startup.
# IMAGE_PROVIDER=openai

# Optional. Google's own variable for pointing the storage client at a local
# emulator instead of real GCS; the client honours it directly. When it is set the
# server also creates the bucket at startup, which real deployments must not do.
# docker-compose.yml sets this to the emulator it runs.
# STORAGE_EMULATOR_HOST=localhost:4443

# Comma-separated list of allowed frontend origins. "*" is rejected.
ALLOWED_ORIGINS=http://localhost:3000

# Optional. App Engine sets this automatically; defaults to 8080 locally.
# PORT=8080

# Optional. One of debug, info, warn, error. Defaults to info. An unrecognised
# value is rejected at startup rather than silently ignored, because a typo would
# otherwise show up only as log lines that never appear.
#
# debug adds per-request detail: rejected tokens, unparseable bodies, stored
# objects. Useful locally, too noisy and too revealing for production.
# LOG_LEVEL=info
